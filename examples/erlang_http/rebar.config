%% Example application: build with rebar3 and flash to an ESP32 via AtomVM.

{erl_opts, [debug_info]}.
{deps, [
    {atomvm_httpd, {git, "https://github.com/harmon25/atomvm_httpd.git", {branch, "main"}}}
]}.
{plugins, [
    rebar_mix,
    atomvm_rebar3_plugin
]}.
{atomvm_rebar3_plugin, [
    {packbeam, [prune]}
]}.
